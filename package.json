{
	"name": "@inference-net/otel-cf-workers",
	"version": "3.0.0",
	"module": "./dist/index.js",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"clean": "rm -rf ./dist",
		"format": "prettier --ignore-unknown --write .",
		"format:check": "prettier . --check --ignore-unknown",
		"build": "vite build",
		"check:types": "tsc --noEmit",
		"check": "bun run format:check && bun run check:types",
		"watch": "vite build --watch",
		"prepare": "command -v husky >/dev/null && husky || true",
		"test": "vitest run",
		"test:dev": "vitest",
		"lint-staged": "lint-staged",
		"ci": "bun run clean && bun run check && bun run build && bun run test",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish"
	},
	"files": [
		"dist"
	],
	"homepage": "https://github.com/context-labs/otel-cf-workers#readme",
	"dependencies": {
		"@opentelemetry/core": "^2.2",
		"@opentelemetry/exporter-trace-otlp-http": "^0.208",
		"@opentelemetry/otlp-exporter-base": "^0.208",
		"@opentelemetry/otlp-transformer": "^0.208",
		"@opentelemetry/resources": "^2.2",
		"@opentelemetry/sdk-trace-base": "^2.2",
		"@opentelemetry/semantic-conventions": "^1.33"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"@cloudflare/vitest-pool-workers": "0.21.3",
		"@cloudflare/workers-types": "^4.20251119.0",
		"@effect/vitest": "4.0.0-rc.109",
		"@opentelemetry/api": "~1.9.0",
		"effect": "4.0.0-rc.109",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"prettier": "^3.5.3",
		"typescript": "5",
		"vite": "^7.2.2",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@opentelemetry/api": "~1.9.0",
		"effect": "4.0.0-rc.109"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "BSD-3-Clause",
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"packageManager": "bun@canary"
}
